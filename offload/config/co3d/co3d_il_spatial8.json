{
    "model_name": "vggt_omega",
    "dataset_name": "co3dv2",
    "dataset_kwargs": {
        "categories": [
            "hotdog",
            "tv",
            "parkingmeter",
            "baseballbat"
        ],
        "frames_per_sequence": 8,
        "frame_stride": 5
    },
    "batch_size": 8,
    "image_shape": [
        512,
        512,
        3
    ],
    "patch_size": [
        16,
        16
    ],
    "input_profile_name": "vggt_omega_512",
    "scheduler_policy_name": "VGGTInterleaved",
    "transmission_policy_name": "VGGTLaplacian",
    "appcorr_kwargs": {
        "enabled": true,
        "token_keep_ratio": 1.0,
        "mobile_pscore": "none",
        "mobile_pscore_weight": 0.0,
        "server_pscore": "patch_pseudo_attn_prob_layermean",
        "server_pscore_weight": 1.0,
        "pscore_fusion": "add",
        "sdpa_query_bucket_size": 64
    },
    "exp_id": "co3d_il_spatial8",
    "transmission_kwargs": {
        "pyramid_levels": [
            3,
            0
        ],
        "num_groups": 1,
        "compression_level": 1,
        "preserve_input_shape": true,
        "correction_grouping": "spatial",
        "correction_groups": 8
    },
    "scheduler_kwargs": {
        "total_layers": 48
    }
}
